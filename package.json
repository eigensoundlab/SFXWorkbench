{
  "name": "sfx-workbench",
  "version": "0.5.0",
  "description": "Browser tool for designing game sound effects: edit, time-stretch, re-pitch, generate, vary, morph, slice and loop. WAV in, WAV out at source quality.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "author": "Daniel Sandner (https://orcid.org/0000-0002-1041-814X)",
  "homepage": "https://eigensoundlab.github.io/SFXWorkbench/",
  "repository": { "type": "git", "url": "git+https://github.com/eigensoundlab/SFXWorkbench.git" },
  "bugs": { "url": "https://github.com/eigensoundlab/SFXWorkbench/issues" },
  "keywords": ["sound design", "sfx", "game audio", "foley", "web audio", "dsp", "time-stretch", "wav", "physical modelling", "procedural audio"],
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test \"tests/*.test.js\"",
    "lint": "eslint .",
    "build": "node scripts/build.mjs",
    "check": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "esbuild": "0.24.2",
    "eslint": "9.17.0",
    "globals": "15.14.0"
  }
}
